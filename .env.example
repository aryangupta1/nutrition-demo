# All optional. Unset = the real, indexable site ("full" mode). No env vars are required to deploy.

# "preview" turns this deployment into a concept preview for Annette:
# noindex everywhere, robots Disallow: /, empty sitemap, no JSON-LD, minimal llms.txt,
# preview badge, and parts of the homepage locked as "To be built" / "Needs your input".
SITE_MODE="preview"

# Optional: lets you unlock the full content on a preview deployment for a call.
# Send https://<preview-url>/?unlock=<code>. It sets a signed cookie for 4 hours. The site stays noindex.
PREVIEW_UNLOCK_CODE=
PREVIEW_COOKIE_SECRET=
